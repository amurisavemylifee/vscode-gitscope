{
  "name": "git-scope",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "amurisavemylifee",
  "author": "Taras Shashurin",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/amurisavemylifee/vscode-gitscope"
  },
  "bugs": {
    "url": "https://github.com/amurisavemylifee/vscode-gitscope/issues"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "compare",
    "branch",
    "review",
    "history",
    "revisions"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:gitscope.compare",
    "onWebviewPanel:gitscope.fileHistory"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitscope.compareRevisions",
        "title": "%command.compareRevisions.title%",
        "category": "GitScope",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitscope.fileHistory",
        "title": "%command.fileHistory.title%",
        "category": "GitScope",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitscope.fileHistory",
          "when": "editorIsOpen"
        }
      ],
      "editor/context": [
        {
          "command": "gitscope.fileHistory",
          "when": "resourceScheme == file",
          "group": "gitscope@1"
        }
      ],
      "explorer/context": [
        {
          "command": "gitscope.fileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitscope@1"
        }
      ]
    },
    "configuration": {
      "title": "GitScope",
      "properties": {
        "gitscope.diff.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 50,
          "description": "%configuration.contextLines.description%"
        },
        "gitscope.diff.collapseFilesOverLines": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "description": "%configuration.collapseFilesOverLines.description%"
        },
        "gitscope.diff.defaultViewMode": {
          "type": "string",
          "enum": [
            "unified",
            "split"
          ],
          "default": "unified",
          "enumDescriptions": [
            "%configuration.defaultViewMode.unified%",
            "%configuration.defaultViewMode.split%"
          ],
          "description": "%configuration.defaultViewMode.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm run build:ext && pnpm run build:webview",
    "build:ext": "node esbuild.config.mjs --production",
    "build:webview": "vite build",
    "dev:ext": "node esbuild.config.mjs --watch",
    "dev:webview": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && pnpm run build:e2e && node scripts/prepareE2eWorkspace.mjs && vscode-test",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "build:e2e": "node esbuild.config.mjs --e2e"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "~1.95.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
